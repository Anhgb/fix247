# Fix 24/7 – Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=fix247
POSTGRES_PASSWORD=fix247pass
POSTGRES_DB=fix247
DATABASE_URL=postgresql+asyncpg://fix247:fix247pass@localhost:5432/fix247
DATABASE_URL_SYNC=postgresql://fix247:fix247pass@localhost:5432/fix247

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_MEDIA=fix247-media
MINIO_BUCKET_PUBLIC=fix247-public

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_256_BIT_RANDOM
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# ── Encryption (AES-256 for CCCD / national ID) ───────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX_ENCODED_KEY_0000000000000000000000

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Provider Selection (mock | real) ─────────────────────────────────────────
# All default to "mock" so the app runs with no API keys
PROVIDER_OTP=mock          # mock | esms | twilio
PROVIDER_AI=mock           # mock | gemini | openai
PROVIDER_MAPS=mock         # mock | googlemaps | goong
PROVIDER_PUSH=mock         # mock | fcm | webpush
PROVIDER_PAYMENT=mock      # mock | vietqr | momo | vnpay

# ── AI Providers (only needed when PROVIDER_AI=gemini|openai) ────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── OTP / SMS (only needed when PROVIDER_OTP=esms|twilio) ───────────────────
ESMS_API_KEY=
ESMS_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Maps (only needed when PROVIDER_MAPS=googlemaps|goong) ──────────────────
GOOGLE_MAPS_API_KEY=
GOONG_API_KEY=

# ── Push (only needed when PROVIDER_PUSH=fcm|webpush) ───────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Payment (only needed when PROVIDER_PAYMENT=momo|vnpay) ──────────────────
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000/fix247-public
NEXT_PUBLIC_MAP_PROVIDER=osm   # osm | google | goong
